#!/bin/sh
# Gradle wrapper script
GRADLE_WRAPPER_URL="https://services.gradle.org/distributions/gradle-8.2-bin.zip"
GRADLE_HOME="$HOME/.gradle/wrapper/dists/gradle-8.2-bin"

if [ ! -d "$GRADLE_HOME" ]; then
    echo "Downloading Gradle..."
    mkdir -p "$GRADLE_HOME"
    curl -L "$GRADLE_WRAPPER_URL" -o /tmp/gradle.zip
    unzip -q /tmp/gradle.zip -d "$GRADLE_HOME"
fi

exec "$GRADLE_HOME"/gradle-8.2/bin/gradle "$@"
